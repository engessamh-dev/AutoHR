{
  "name": "autohr",
  "version": "1.1.0",
  "description": "AutoHR - HR & Document Management System",
  "type": "module",
  "scripts": {
    "test:scanner": "cargo test -p autohr --lib --offline && playwright test",
    "test:scanner:ui": "playwright test",
    "dev": "vite",
    "build": "vite build",
    "tauri": "tauri",
    "tauri:dev": "tauri dev --config src-tauri/tauri.dev.conf.json",
    "tauri:build": "tauri build",
    "tauri:release": "tauri build --config src-tauri/tauri.release.conf.json",
    "seed-db": "node scripts/seed-database.js",
    "test-data": "node scripts/test-data.js",
    "seed-fake-employees": "node scripts/seed-fake-employees.js",
    "seed-fake-employees:dev": "node scripts/seed-fake-employees.js --dev-runtime",
    "sync-version": "node scripts/sync-version.js",
    "version:patch": "npm version patch --no-git-tag-version && npm run sync-version",
    "version:minor": "npm version minor --no-git-tag-version && npm run sync-version",
    "version:major": "npm version major --no-git-tag-version && npm run sync-version",
    "verify:databases": "python scripts/verify-databases.py"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tauri-apps/cli": "^2.12.6",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^11.10.0",
    "esbuild": "^0.28.1",
    "postcss": "^8.5.29",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.8"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.5",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-notification": "^2.8.1",
    "pdfjs-dist": "^6.4.299"
  }
}
