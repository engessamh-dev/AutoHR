*.log
target/

node_modules/

.env
test-results/
playwright-report/

# Private scanner verification images and diagnostics
.scanner-local/

# Local database audit artifacts may contain attachment paths
verification/

# Release installers belong in GitHub Releases or the internal update server, not in Git.
*.exe
*.msi
*.nsis.zip
*.sig
# SQLite runtime sidecars for the development fixture database.
src-tauri/resources/*.db-wal
src-tauri/resources/*.db-shm
# Encrypted backups may contain real employee data.
*.autohrbak

# Updater signing keys: the private key must never be committed
*.key
*.key.pub
.tauri/

# Local notes about where the installer was built
.exe path.txt

# Developer unlock key (tools/admin-unlock): never commit a private key
*.pem
CNSArch-unlock-key/
